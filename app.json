{
  "expo": {
    "name": "choloBD-mobile",
    "scheme": "cholobd",
    "slug": "choloBD-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7FB",
      "dark": {
        "image": "./assets/app-icon.png",
        "backgroundColor": "#0C0C0F"
      }
    },
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:cholo-bd.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to scan QR codes for check-in verification."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.choloBDmobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cholo-bd.com",
              "pathPrefix": "/bookings/stay"
            },
            {
              "scheme": "https",
              "host": "cholo-bd.com",
              "pathPrefix": "/bookings/ticket"
            },
            {
              "scheme": "https",
              "host": "cholo-bd.com",
              "path": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "./plugins/withKotlinJvm17",
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "react-native-vision-camera",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CholoBD app to access your camera for QR code scanning."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ]
  }
}
